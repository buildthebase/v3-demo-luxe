# Static video files are cached by browsers and the CDN, with ETag revalidation.
# Use a new filename whenever a video changes; do not overwrite existing cuts.
/*.mp4
  Cache-Control: public, max-age=604800, s-maxage=2592000, stale-while-revalidate=604800
/*.webm
  Cache-Control: public, max-age=604800, s-maxage=2592000, stale-while-revalidate=604800
